{
  "name": "meridian-graphhacks",
  "version": "1.0.0",
  "private": true,
  "description": "MERIDIAN \u2014 Living Company Brain. Autonomous agent crew with FalkorDB as memory, reasoning and action layer. Graph Hacks 2026.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --incremental false",
    "seed": "tsx scripts/seed.ts",
    "eval": "tsx scripts/eval.ts",
    "test": "tsx --test scripts/test.ts",
    "ablation": "tsx scripts/ablation.ts",
    "cypher": "tsx scripts/dump-cypher.ts",
    "live:seed": "tsx scripts/live-seed.ts",
    "live:check": "tsx scripts/live-check.ts",
    "verify": "npm run typecheck && npm run test && npm run eval && npm run ablation",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "falkordb": "^6.6.2",
    "next": "15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "falkordblite": "^0.3.0",
    "playwright-core": "^1.64.0",
    "postcss": "8.5.18",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "allowScripts": {
    "falkordblite@0.3.0": true
  },
  "overrides": {
    "postcss": "8.5.18",
    "postcss-selector-parser": "6.1.5",
    "tar": "7.5.21",
    "sharp": "0.35.5",
    "undici": "8.12.2",
    "js-yaml": "4.3.2",
    "smol-toml": "1.7.1",
    "follow-redirects": "1.16.2",
    "axios": "1.20.0",
    "fast-uri": "4.1.4",
    "ip-address": "10.3.1",
    "@azure/msal-node": "7.1.0",
    "@opentelemetry/propagator-jaeger": "2.9.0",
    "markdown-it": "14.3.3",
    "source-map-js": "1.2.2",
    "minimatch": "11.0.9"
  }
}
